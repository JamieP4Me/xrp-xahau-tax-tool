{
  "name": "xrp-xahau-tax-tool",
  "productName": "XRP & Xahau Tax Tool",
  "version": "1.10.3",
  "description": "Local desktop app for full XRP/Xahau transaction history and Form 8949/Schedule D generation, backed by a local SQLite cache with incremental sync.",
  "main": "main.js",
  "author": "XRP & Xahau Tax Tool contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "start": "electron .",
    "test:db": "node test/db.test.js && node test/verify-xrpl.test.js && node test/iou-inventory.test.js && node test/sign-native.test.js && node test/supply-chain.test.js && node test/price-tables.test.js",
    "test:e2e": "playwright test test/*.spec.js --reporter=line",
    "test": "npm run test:db && npm run test:e2e",
    "pack": "electron-builder --dir",
    "dist": "node scripts/verify-clean.js && electron-builder",
    "dist:linux": "node scripts/verify-clean.js && electron-builder --linux",
    "dist:mac": "node scripts/verify-clean.js && electron-builder --mac",
    "dist:win": "node scripts/verify-clean.js && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "verify:clean": "node scripts/verify-clean.js",
    "verify:xrpl": "node scripts/verify-xrpl.js",
    "prestart": "node scripts/check-abi.js electron",
    "pretest:db": "node scripts/check-abi.js node",
    "pretest:e2e": "node scripts/check-abi.js electron",
    "preverify:xrpl": "node scripts/check-abi.js node",
    "predist:mac": "node scripts/check-abi.js electron",
    "predist:win": "node scripts/check-abi.js electron",
    "predist:linux": "node scripts/check-abi.js electron",
    "iou:inventory": "node scripts/iou-inventory.js",
    "preiou:inventory": "node scripts/check-abi.js node",
    "probe:xahau": "node scripts/probe-xahau-iou.js",
    "preprobe:xahau": "node scripts/check-abi.js node",
    "audit:types": "node scripts/audit-types.js",
    "preaudit:types": "node scripts/check-abi.js node",
    "evernode": "node scripts/evernode-income.js",
    "preevernode": "node scripts/check-abi.js node",
    "wallets": "node scripts/wallets.js",
    "prewallets": "node scripts/check-abi.js node",
    "counterparties": "node scripts/counterparties.js",
    "precounterparties": "node scripts/check-abi.js node",
    "windb:schema": "node scripts/windb-schema.js",
    "cache:optimise": "node scripts/optimise-cache.js",
    "precache:optimise": "node scripts/check-abi.js node",
    "oracle:prices": "node scripts/oracle-prices.js",
    "prices:update": "node scripts/update-prices.js",
    "probe:remit": "node scripts/probe-remit-raw.js",
    "preprobe:remit": "node scripts/check-abi.js node",
    "postrebuild": "node scripts/sign-native.js",
    "sign:native": "node scripts/sign-native.js",
    "gaps": "node scripts/gaps.js",
    "pregaps": "node scripts/check-abi.js node",
    "lp:pairing": "node scripts/lp-pairing.js",
    "prelp:pairing": "node scripts/check-abi.js node",
    "xahau:basis": "node scripts/xahau-basis.js",
    "prexahau:basis": "node scripts/check-abi.js node"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.56.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3",
    "jspdf": "^4.2.1",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "build": {
    "appId": "io.github.xrpxahautaxtool",
    "productName": "XRP & Xahau Tax Tool",
    "asar": true,
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "renderer/**/*",
      "package.json",
      "!node_modules/better-sqlite3/prebuilds/{linux,linuxmusl,win32}-*.node"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist-installers"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "x64ArchFiles": "**/better-sqlite3/prebuilds/*.node"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "afterPack": "scripts/adhoc-sign.js"
  }
}
